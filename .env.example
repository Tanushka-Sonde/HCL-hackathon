# =============================================================
# Enterprise Knowledge Assistant — local demo mode (default)
# Runs without PostgreSQL / MinIO / Redis / Google OAuth.
# =============================================================
DEMO_MODE=true
APP_NAME=Enterprise Knowledge Assistant
# LLM for grounded generation. Leave empty to use the deterministic
# extractive fallback (answers are then marked LLM_FALLBACK / Partial).
GROQ_API_KEY=
# Text model. Check which models your key offers:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL_NAME=openai/gpt-oss-120b
# gpt-oss models reason before answering; "low" keeps answers inside the output budget.
GROQ_REASONING_EFFORT=low
# Vision model (same GROQ_API_KEY) for scanned pages, image uploads and charts.
# Must accept image input (qwen3.8-27b does; gpt-oss models do not).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
KIS_VISION_ENABLED=true
# Max vision calls per uploaded document (pages beyond this are skipped and listed).
KIS_VISION_MAX_PAGES=30
# Tables are kept whole; longer tables are split by rows with the header repeated.
KIS_TABLE_CHUNK_MAX_CHARS=4000
# Server-side caps for the per-question token budgets users can set.
KIS_MAX_INPUT_TOKENS_CAP=8000
KIS_MAX_OUTPUT_TOKENS_CAP=1500
# Images attached to questions (/kis/query/multimodal). Raw images are not
# stored unless this is true; the description is always logged.
KIS_QUERY_IMAGE_MAX_MB=10
KIS_STORE_QUERY_IMAGES=false
# Evaluation pacing for hosted-LLM rate limits; the judge adds one call per case.
KIS_EVAL_PAUSE_SECONDS=2.2
KIS_EVAL_JUDGE=true
# Unusual-activity thresholds shown to admins (Users page, Observability)
KIS_USER_DAILY_TOKEN_CAP=200000
KIS_ANOMALY_BURST_PER_5MIN=20
KIS_ANOMALY_INJECTION_PER_24H=2
KIS_ANOMALY_PII_PER_24H=3
KIS_ANOMALY_FAILED_LOGINS_10MIN=5
KIS_ANOMALY_FORBIDDEN_PER_24H=3
KIS_ANOMALY_TOKEN_SPIKE_FACTOR=3
KIS_OFF_HOURS_START=0
KIS_OFF_HOURS_END=5
# Estimated price per 1K tokens (USD) used for the cost KPI.
LLM_PRICE_INPUT_PER_1K=0.00005
LLM_PRICE_OUTPUT_PER_1K=0.00008
# Retrieval / indexing
KIS_DATA_DIR=data
# KIS_EMBEDDER: "sentence-transformers" or "hashing" (offline, lexical only)
KIS_EMBEDDER=sentence-transformers
# KIS_RERANKER: "cross-encoder" or "lexical"
KIS_RERANKER=cross-encoder
KIS_CHUNK_SIZE=800
KIS_CHUNK_OVERLAP=120
KIS_MIN_EVIDENCE_SCORE=0.6
KIS_GROUNDING_THRESHOLD=0.7
# Sign-in (demo mode) also uses JWT_SECRET_KEY (set in the section below).
# Set a long random value so logins survive restarts:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If it is left as the placeholder, a random per-process secret is used.
KIS_TOKEN_EXPIRE_MINUTES=480
KIS_MAX_UPLOAD_MB=20

# =============================================================
# Production mode only (DEMO_MODE=false): settings below
# =============================================================

# =============================================================
# Database (PostgreSQL + pgvector)
# =============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# =============================================================
# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================
# Object Storage (MinIO / S3-compatible)
# =============================================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=research-documents
MINIO_SECURE=false

# =============================================================
# Authentication
# =============================================================
JWT_SECRET_KEY=change-me-to-a-random-256-bit-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================
# External APIs
# =============================================================
GOOGLE_API_KEY=your-google-api-key
TAVILY_API_KEY=your-tavily-api-key

# =============================================================
# LLM Gateway
# =============================================================
LLM_MODEL_NAME=models/gemini-2.0-flash
LLM_RATE_LIMIT_RPM=15
LLM_CONCURRENCY_LIMIT=5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# =============================================================
# Embedding
# =============================================================
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================
# Retrieval
# =============================================================
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_MULTIPLIER=2

# =============================================================
# Ingestion Worker
# =============================================================
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_MAX_CONCURRENT_JOBS=2
WORKER_STALE_CLAIM_TIMEOUT_MINUTES=10

# =============================================================
# Server
# =============================================================
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# =============================================================
# Redis (v3.0 only — distributed rate limiting)
# =============================================================
# REDIS_URL=redis://localhost:6379/0
