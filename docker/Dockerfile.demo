# Single-container backend for the local demo mode (cloud-compatible).
# NOTE: not built or tested on the dev machine (Docker was not available).
#
#   docker build -f docker/Dockerfile.demo -t eka-backend .
#   docker run -p 8000:8000 -e JWT_SECRET_KEY=... -e GROQ_API_KEY=... eka-backend
#
# Or run backend + frontend together: docker compose -f docker-compose.demo.yml up
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DEMO_MODE=true KIS_DATA_DIR=/data
WORKDIR /app

COPY requirements-demo.txt .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements-demo.txt

COPY src ./src
COPY scripts ./scripts
COPY demo ./demo

# Seeding runs at start-up (it is idempotent), so a volume mounted on /data
# keeps users, documents and query events across restarts.
EXPOSE 8000
CMD ["sh", "-c", "python scripts/seed_demo.py && exec uvicorn src.main:app --host 0.0.0.0 --port 8000"]
