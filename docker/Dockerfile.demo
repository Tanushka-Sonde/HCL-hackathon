# Single-container backend for the local demo mode (cloud-compatible).
# NOTE: written for cloud readiness; not built/tested on the dev machine
# (Docker was not available there).
#
#   docker build -f docker/Dockerfile.demo -t eka-backend .
#   docker run -p 8000:8000 -e GROQ_API_KEY=... eka-backend
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DEMO_MODE=true
WORKDIR /app

COPY requirements-demo.txt .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements-demo.txt

COPY src ./src
COPY scripts ./scripts
COPY demo ./demo

RUN python scripts/build_demo.py && python scripts/seed_demo.py

EXPOSE 8000
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
