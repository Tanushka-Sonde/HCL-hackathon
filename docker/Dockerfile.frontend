# Next.js frontend for the local demo mode.
# NOTE: not built or tested on the dev machine (Docker was not available).
#
# Next.js reads the rewrite target at build time, so BACKEND_URL is a build
# argument (docker-compose.demo.yml sets it to the backend service).
FROM node:22-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG BACKEND_URL=http://backend:8000
ENV BACKEND_URL=$BACKEND_URL NEXT_PUBLIC_DEMO_MODE=true NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app ./
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
